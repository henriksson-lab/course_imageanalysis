{
  "_doc": "Model checkpoints and public microscopy sample images for the network demos (plan/segmodels-plan.md). Read by tools/models/fetch.py (`make models`): downloads into .cache/models/downloads/, converts into demos/dist/models/<out> and writes demos/dist/models/index.json. 'bytes' and 'sha256' are of the download and are checked. 'enabled': false entries are only fetched with --all or --only. Steps are documented in tools/models/README.md.",
  "version": 1,
  "tools": {
    "yolov11-rs": {
      "doc": "Key remapping of YOLOv11-pt checkpoints to the YOLOv11-rs module names.",
      "base": "https://raw.githubusercontent.com/henriksson-lab/YOLOv11-rs/041c9f0277692f32791688b76fb8926cd21697ca/",
      "files": [
        "convert_weights.py"
      ]
    },
    "yolov11-pt": {
      "doc": "Model classes (and their import utils/util.py, which needs torchvision) needed to unpickle the YOLOv11-pt checkpoints (placed where convert_weights.py looks: <tools>/yolov11-rs/YOLOv11-pt/).",
      "base": "https://raw.githubusercontent.com/jahongir7174/YOLOv11-pt/e4987b35a1bd1157d275d144ffdbca601ba97e44/",
      "files": [
        "nets/nn.py",
        "utils/util.py"
      ],
      "dest": "yolov11-rs/YOLOv11-pt"
    },
    "sam2-rs": {
      "doc": "Official SAM 2 .pt checkpoint -> flat safetensors state dict (no renaming).",
      "base": "https://raw.githubusercontent.com/henriksson-lab/sam2-rs/edb4cb76cfd85bdc69915893a9addea7ebe3bd62/",
      "files": [
        "tools/convert_checkpoint.py"
      ]
    }
  },
  "entries": [
    {
      "id": "stardist-2d-versatile-fluo",
      "kind": "model",
      "enabled": true,
      "url": "https://github.com/stardist/stardist-models/releases/download/v0.1/python_2D_versatile_fluo.zip",
      "file": "python_2D_versatile_fluo.zip",
      "bytes": 5320433,
      "sha256": "4ad678d0758eed6e55625f1b5ae30771e59adb79f1239e09b9772eac8846c3dd",
      "loads_with": "demos/wasm/stardist (stardistnet demo): weights_best.h5 read from bytes by src/h5.rs into stardist-rs KerasWeights (same result as stardist-rs weights::load_keras_hdf5_weights, which needs a file path) + config.json + thresholds.json. Keras HDF5, f32, kept as is (5.5 MB; f16 would save 2.7 MB but needs a conversion op)",
      "credit": "StarDist 2D_versatile_fluo (Schmidt, Weigert et al.), BSD-3-Clause",
      "steps": [
        {
          "op": "unzip",
          "members": {
            "config.json": "stardist/2D_versatile_fluo/config.json",
            "thresholds.json": "stardist/2D_versatile_fluo/thresholds.json",
            "weights_best.h5": "stardist/2D_versatile_fluo/weights_best.h5"
          }
        }
      ]
    },
    {
      "id": "cellpose-cyto3",
      "kind": "model",
      "enabled": true,
      "url": "https://www.cellpose.org/models/cyto3",
      "file": "cyto3",
      "bytes": 26566255,
      "sha256": "2dc3087a8abd7da46d1ab0ddd5824639933cc3ff63b382af3fa1939a392db93c",
      "loads_with": "demos/wasm/cellpose (CellposeNet::new(bytes): Cellpose 3 U-net, 2 input channels, style vector; safetensors F16/BF16/F32). cellpose-rs itself implements only Cellpose-SAM/CPDINO",
      "credit": "Cellpose cyto3 (Stringer, Pachitariu), BSD-3-Clause",
      "steps": [
        {
          "op": "torch_to_safetensors",
          "dtype": "bf16",
          "out": "cellpose/cyto3.safetensors"
        }
      ],
      "note": "bf16, not f16: cyto3's batch-norm running variances reach 3.3e6, beyond f16's range (65504), and f16 turns them into inf (the network then outputs a constant). bf16 keeps f32's range: masks agree with f32 (AP@0.5 0.995-1.0 on cellpose-img00/img02)"
    },
    {
      "id": "cellpose-cyto3-size",
      "kind": "model",
      "enabled": true,
      "url": "https://www.cellpose.org/models/size_cyto3.npy",
      "file": "size_cyto3.npy",
      "bytes": 3627,
      "sha256": "87f91feb48019b4dfb0400e7bbb89aca5873368686815aa7b4431c0faee97fc5",
      "loads_with": "Cellpose 3 size model (linear regression from the style vector to the cell diameter), NumPy pickle",
      "credit": "Cellpose (Stringer, Pachitariu), BSD-3-Clause",
      "steps": [
        {
          "op": "npy_size_model",
          "out": "cellpose/size_cyto3.json"
        }
      ]
    },
    {
      "id": "cellpose-nuclei",
      "kind": "model",
      "enabled": true,
      "url": "https://www.cellpose.org/models/nucleitorch_0",
      "file": "nucleitorch_0",
      "bytes": 26563614,
      "sha256": "89ca45e4a45048d5010d29621466b1274b91b3dcb9714dce9f9e90a9a8671303",
      "loads_with": "demos/wasm/cellpose (same as cyto3). Cellpose 3 U-net, nuclei model (mean diameter 17 px); f16 is safe here (masks identical to f32 on bbbc039-A02_s1, AP 0.997 on dsb-fluo-dense)",
      "credit": "Cellpose nuclei (Stringer, Pachitariu), BSD-3-Clause",
      "steps": [
        {
          "op": "torch_to_safetensors",
          "dtype": "f16",
          "out": "cellpose/nuclei.safetensors"
        }
      ]
    },
    {
      "id": "cellpose-sam",
      "kind": "model",
      "enabled": false,
      "url": "https://huggingface.co/mouseland/cellpose-sam/resolve/main/cpsam",
      "file": "cpsam",
      "bytes": 1233587898,
      "sha256": "",
      "loads_with": "cellpose-rs: network::load_model(path) (.pth or .safetensors; ViT-L encoder, ~300 M parameters)",
      "credit": "Cellpose-SAM (Pachitariu, Rariden, Stringer), BSD-3-Clause",
      "note": "Disabled: 1.2 GB download, ~620 MB even in f16, too large for GitHub Pages (~1 GB site limit). Fetch with --only cellpose-sam.",
      "steps": [
        {
          "op": "torch_to_safetensors",
          "dtype": "f16",
          "out": "cellpose/cpsam.safetensors"
        }
      ]
    },
    {
      "id": "yolo11n-coco",
      "kind": "model",
      "enabled": true,
      "url": "https://github.com/jahongir7174/YOLOv11-pt/releases/download/v0.0.1/v11_n.pt",
      "file": "v11_n.pt",
      "bytes": 5486426,
      "sha256": "da6d7a11889186298a4d316803373d6584cb3e42a63480144ac83ded7f194183",
      "loads_with": "demos/wasm/yolo (vendored YOLOv11-rs model, Burn CPU backend): yolo_v11_n(80) + burn-store SafetensorsStore with head.{box,cls}_branches.i.cK -> head.{box,cls}_cK.i remapping and the PyTorch BatchNorm adapter (f16 stored, computed in f32)",
      "credit": "YOLOv11 nano, COCO-trained, YOLOv11-pt re-implementation (jahongir7174) of Ultralytics YOLO11, AGPL-3.0",
      "steps": [
        {
          "op": "yolov11_convert",
          "out": "yolo/yolo11n-coco.safetensors",
          "dtype": "f16"
        }
      ]
    },
    {
      "id": "yolo11n-ultralytics",
      "kind": "model",
      "enabled": false,
      "url": "https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt",
      "file": "yolo11n.pt",
      "bytes": 5613764,
      "sha256": "",
      "loads_with": "Upstream Ultralytics checkpoint (pickled ultralytics classes); YOLOv11-rs expects the YOLOv11-pt layout above, so this is a reference only",
      "credit": "Ultralytics YOLO11n, AGPL-3.0",
      "steps": [
        {
          "op": "copy",
          "out": "yolo/yolo11n-ultralytics.pt"
        }
      ]
    },
